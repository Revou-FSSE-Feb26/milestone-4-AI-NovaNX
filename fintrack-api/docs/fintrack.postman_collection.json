      ]
    },
    {
      "name": "Transactions",
      "item": [
        {
          "name": "List transactions (nested account/category)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/transactions",
              "host": ["{{baseUrl}}"],
              "path": ["transactions"]
            },
            "description": "Each transaction includes its `account`, `toAccount` (transfer destination, if any) and `category` nested in the same response (Prisma `include`)."
          }
        },
        {
          "name": "Get transaction by id (nested account/category)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/transactions/1",
              "host": ["{{baseUrl}}"],
              "path": ["transactions", "1"]
            }
          }
        },
        {
          "name": "Create transaction - income (happy path)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"account_id\": 1,\n  \"category_id\": 1,\n  \"type\": \"income\",\n  \"amount\": 9000000,\n  \"description\": \"August salary\",\n  \"transaction_date\": \"2026-08-01\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/transactions",
              "host": ["{{baseUrl}}"],
              "path": ["transactions"]
            }
          }
        },
        {
          "name": "Create transaction - expense (happy path)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"account_id\": 1,\n  \"category_id\": 3,\n  \"type\": \"expense\",\n  \"amount\": 120000,\n  \"description\": \"Dinner\",\n  \"transaction_date\": \"2026-08-02\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/transactions",
              "host": ["{{baseUrl}}"],
              "path": ["transactions"]
            }
          }
        },
        {
          "name": "Create transaction - transfer, same user (happy path)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"account_id\": 1,\n  \"to_account_id\": 2,\n  \"type\": \"transfer\",\n  \"amount\": 100000,\n  \"description\": \"Top up dompet harian\",\n  \"transaction_date\": \"2026-08-03\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/transactions",
              "host": ["{{baseUrl}}"],
              "path": ["transactions"]
            },
            "description": "Account 1 (BCA Utama) and account 2 (Dompet Harian) both belong to user 1, so this transfer is allowed and moves the balance between them."
          }
        },
        {
          "name": "Create transaction - transfer cross-user (validation error)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"account_id\": 1,\n  \"to_account_id\": 3,\n  \"type\": \"transfer\",\n  \"amount\": 100000,\n  \"transaction_date\": \"2026-08-03\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/transactions",
              "host": ["{{baseUrl}}"],
              "path": ["transactions"]
            },
            "description": "Account 1 belongs to user 1, account 3 belongs to user 2 — transfers are only allowed between accounts owned by the same user. Expect 400 Bad Request."
          },
          "response": [
            {
              "name": "400 Bad Request",
              "originalRequest": {
                "method": "POST",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/transactions",
                  "host": ["{{baseUrl}}"],
                  "path": ["transactions"]
                }
              },
              "status": "Bad Request",
              "code": 400,
              "_postman_previewlanguage": "json",
              "header": [
                { "key": "Content-Type", "value": "application/json" }
              ],
              "body": "{\n  \"message\": \"Transfers are only allowed between accounts owned by the same user\",\n  \"error\": \"Bad Request\",\n  \"statusCode\": 400\n}"
            }
          ]
        },
        {
          "name": "Create transaction - validation error",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"account_id\": 1,\n  \"type\": \"withdrawal\",\n  \"transaction_date\": \"2026-08-03\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/transactions",
              "host": ["{{baseUrl}}"],
              "path": ["transactions"]
            },
            "description": "Missing required `category_id`/`amount`, and `type` is not one of income | expense | transfer. Expect 400 Bad Request."
          },
          "response": [
            {
              "name": "400 Bad Request",
              "originalRequest": {
                "method": "POST",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/transactions",
                  "host": ["{{baseUrl}}"],
                  "path": ["transactions"]
                }
              },
              "status": "Bad Request",
              "code": 400,
              "_postman_previewlanguage": "json",
              "header": [
                { "key": "Content-Type", "value": "application/json" }
              ],
              "body": "{\n  \"message\": [\n    \"category_id must not be less than 1\",\n    \"category_id must be an integer number\",\n    \"type must be one of the following values: income, expense, transfer\",\n    \"amount must not be less than 0.01\",\n    \"amount must be a number conforming to the specified constraints\"\n  ],\n  \"error\": \"Bad Request\",\n  \"statusCode\": 400\n}"
            }
          ]
        },
        {
          "name": "Update transaction (happy path)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"June salary (revised)\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/transactions/1",
              "host": ["{{baseUrl}}"],
              "path": ["transactions", "1"]
            }
          }
        },
        {
          "name": "Delete transaction",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/transactions/25",
              "host": ["{{baseUrl}}"],
              "path": ["transactions", "25"]
            },
            "description": "Deletes the income transaction created by \"Create transaction - income (happy path)\" (id 25 on a freshly-seeded database). Deleting it automatically reverses its balance effect."
          }
        }
      ]
    }
  ]
}
