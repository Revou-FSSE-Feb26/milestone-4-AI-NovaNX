{
  "info": {
    "name": "FinTrack API - Auth & Security",
    "description": "Part 4 flow: register, login, JWT-protected resources, ownership isolation, RBAC, invalid tokens, and validation.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "registerEmail", "value": "" },
    { "key": "accessToken", "value": "" },
    { "key": "secondToken", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "accountId", "value": "1" }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.collectionVariables.set('registerEmail', `postman-${Date.now()}@example.com`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Registration succeeds', () => pm.response.to.have.status(201));",
                  "pm.test('Password is hidden', () => pm.expect(pm.response.json()).not.to.have.property('password'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman User\",\n  \"email\": \"{{registerEmail}}\",\n  \"password\": \"Secure123\"\n}"
            },
            "url": "{{baseUrl}}/auth/register"
          }
        },
        {
          "name": "Login and save user token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login succeeds', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('accessToken', pm.response.json().access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{registerEmail}}\",\n  \"password\": \"Secure123\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Login second seeded user",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Second user login succeeds', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('secondToken', pm.response.json().access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"bima@example.com\",\n  \"password\": \"Fintrack123\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Invalid token returns 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Unauthorized', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer invalid-token" }
            ],
            "url": "{{baseUrl}}/accounts"
          }
        }
      ]
    },
    {
      "name": "2. Protected User Flow",
      "item": [
        {
          "name": "Create my account",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Account created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('accountId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Wallet\",\n  \"type\": \"e-wallet\",\n  \"balance\": 250000\n}"
            },
            "url": "{{baseUrl}}/accounts"
          }
        },
        {
          "name": "List my accounts",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Protected account list succeeds', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/accounts"
          }
        },
        {
          "name": "Other user cannot read my account",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Hidden from other owner', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{secondToken}}" }
            ],
            "url": "{{baseUrl}}/accounts/{{accountId}}"
          }
        },
        {
          "name": "Client-supplied user_id is rejected",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Validation rejects forged owner', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": 1,\n  \"name\": \"Forged Account\",\n  \"type\": \"bank\"\n}"
            },
            "url": "{{baseUrl}}/accounts"
          }
        }
      ]
    },
    {
      "name": "3. Admin RBAC",
      "item": [
        {
          "name": "Login seeded admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Admin login succeeds', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('adminToken', pm.response.json().access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alya@example.com\",\n  \"password\": \"Fintrack123\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Admin lists all accounts",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Admin access succeeds', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": "{{baseUrl}}/users/admin/all-accounts"
          }
        },
        {
          "name": "Normal user cannot create category",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Forbidden', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Unauthorized Category\",\n  \"type\": \"expense\"\n}"
            },
            "url": "{{baseUrl}}/categories"
          }
        }
      ]
    }
  ]
}
