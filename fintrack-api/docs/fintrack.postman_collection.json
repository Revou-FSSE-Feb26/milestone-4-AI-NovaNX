{
  "info": {
    "name": "FinTrack API",
    "description": "Postman collection for the FinTrack API (NestJS + Prisma + PostgreSQL). Covers CRUD for users, accounts, categories and transactions, nested relational responses (Prisma `include`), and at least one validation-error example per resource.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000", "type": "string" }
  ],
  "item": [
    {
      "name": "Users",
      "item": [
        {
          "name": "List users (nested accounts, no password)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": ["{{baseUrl}}"],
              "path": ["users"]
            },
            "description": "Returns every user with their `accounts` nested in the same response (Prisma `include`). The password hash is always omitted (Prisma `omit`)."
          }
        },
        {
          "name": "Create user (happy path)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Fajar Nugroho\",\n  \"email\": \"fajar@example.com\",\n  \"password\": \"secret123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": ["{{baseUrl}}"],
              "path": ["users"]
            }
          },
          "response": [
            {
              "name": "201 Created",
              "originalRequest": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Fajar Nugroho\",\n  \"email\": \"fajar@example.com\",\n  \"password\": \"secret123\"\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/users",
                  "host": ["{{baseUrl}}"],
                  "path": ["users"]
                }
              },
              "status": "Created",
              "code": 201,
              "_postman_previewlanguage": "json",
              "header": [
                { "key": "Content-Type", "value": "application/json" }
              ],
              "body": "{\n  \"id\": 6,\n  \"name\": \"Fajar Nugroho\",\n  \"email\": \"fajar@example.com\",\n  \"role\": \"user\",\n  \"created_at\": \"2026-07-29T00:00:00.000Z\"\n}"
            }
          ]
        },
        {
          "name": "Create user - validation error",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"\",\n  \"email\": \"not-an-email\",\n  \"password\": \"123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": ["{{baseUrl}}"],
              "path": ["users"]
            },
            "description": "Empty name, invalid email format, and a password shorter than 6 characters. Expect 400 Bad Request with one message per failed rule."
          },
          "response": [
            {
              "name": "400 Bad Request",
              "originalRequest": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"\",\n  \"email\": \"not-an-email\",\n  \"password\": \"123\"\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/users",
                  "host": ["{{baseUrl}}"],
                  "path": ["users"]
                }
              },
              "status": "Bad Request",
              "code": 400,
              "_postman_previewlanguage": "json",
              "header": [
                { "key": "Content-Type", "value": "application/json" }
              ],
              "body": "{\n  \"message\": [\n    \"name should not be empty\",\n    \"email must be an email\",\n    \"password must be longer than or equal to 6 characters\"\n  ],\n  \"error\": \"Bad Request\",\n  \"statusCode\": 400\n}"
            }
          ]
        },
        {
          "name": "Create user - duplicate email (409)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alya Duplicate\",\n  \"email\": \"alya@example.com\",\n  \"password\": \"secret123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": ["{{baseUrl}}"],
              "path": ["users"]
            },
            "description": "Email already exists in the seed data. Expect 409 Conflict."
          },
          "response": [
            {
              "name": "409 Conflict",
              "originalRequest": {
                "method": "POST",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/users",
                  "host": ["{{baseUrl}}"],
                  "path": ["users"]
                }
              },
              "status": "Conflict",
              "code": 409,
              "_postman_previewlanguage": "json",
              "header": [
                { "key": "Content-Type", "value": "application/json" }
              ],
              "body": "{\n  \"message\": \"Email already registered\",\n  \"error\": \"Conflict\",\n  \"statusCode\": 409\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "Accounts",
      "item": [
        {
          "name": "List accounts",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/accounts",
              "host": ["{{baseUrl}}"],
              "path": ["accounts"]
            }
          }
        },
        {
          "name": "Get account by id (nested transactions)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/accounts/1",
              "host": ["{{baseUrl}}"],
              "path": ["accounts", "1"]
            },
            "description": "Returns the account together with its own `transactions` nested in the same response (Prisma `include`, ordered by transaction_date desc)."
          }
        },
        {
          "name": "Create account (happy path)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": 1,\n  \"name\": \"Jenius Savings\",\n  \"type\": \"bank\",\n  \"balance\": 2500000\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/accounts",
              "host": ["{{baseUrl}}"],
              "path": ["accounts"]
            }
          },
          "response": [
            {
              "name": "201 Created",
              "originalRequest": {
                "method": "POST",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/accounts",
                  "host": ["{{baseUrl}}"],
                  "path": ["accounts"]
                }
              },
              "status": "Created",
              "code": 201,
              "_postman_previewlanguage": "json",
              "header": [
                { "key": "Content-Type", "value": "application/json" }
              ],
              "body": "{\n  \"id\": 7,\n  \"user_id\": 1,\n  \"name\": \"Jenius Savings\",\n  \"type\": \"bank\",\n  \"balance\": 2500000,\n  \"created_at\": \"2026-07-29T00:00:00.000Z\"\n}"
            }
          ]
        },
        {
          "name": "Create account - validation error",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Missing owner\",\n  \"type\": \"crypto\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/accounts",
              "host": ["{{baseUrl}}"],
              "path": ["accounts"]
            },
            "description": "Missing required `user_id` and an invalid `type` (not in cash | bank | e-wallet). Expect 400 Bad Request."
          },
          "response": [
            {
              "name": "400 Bad Request",
              "originalRequest": {
                "method": "POST",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/accounts",
                  "host": ["{{baseUrl}}"],
                  "path": ["accounts"]
                }
              },
              "status": "Bad Request",
              "code": 400,
              "_postman_previewlanguage": "json",
              "header": [
                { "key": "Content-Type", "value": "application/json" }
              ],
              "body": "{\n  \"message\": [\n    \"user_id must not be less than 1\",\n    \"user_id must be an integer number\",\n    \"type must be one of the following values: cash, bank, e-wallet\"\n  ],\n  \"error\": \"Bad Request\",\n  \"statusCode\": 400\n}"
            }
          ]
        },
        {
          "name": "Update account (happy path)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"BCA Utama (Renamed)\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/accounts/1",
              "host": ["{{baseUrl}}"],
              "path": ["accounts", "1"]
            }
          }
        },
        {
          "name": "Delete account",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/accounts/7",
              "host": ["{{baseUrl}}"],
              "path": ["accounts", "7"]
            },
            "description": "Deletes the account created by \"Create account (happy path)\" (id 7 on a freshly-seeded database)."
          }
        }
      ]
    },
    {
